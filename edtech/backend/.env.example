# Copier en .env pour le développement local. Ne JAMAIS committer de vrai secret.
EDTECH_ENVIRONMENT=development
EDTECH_LOG_JSON=false
EDTECH_DATABASE_URL=postgresql+asyncpg://edtech:edtech@localhost:5432/edtech
EDTECH_REDIS_URL=redis://localhost:6379/0

# Telegram (créer un bot avec @BotFather). Laisser vide pour désactiver le bot.
EDTECH_TELEGRAM_BOT_TOKEN=
EDTECH_TELEGRAM_WEBHOOK_SECRET=
EDTECH_TELEGRAM_BOT_USERNAME=
EDTECH_PUBLIC_BASE_URL=
EDTECH_SUPPORT_CHAT_ID=

# Stockage : local en développement, s3 (MinIO) pour tester comme en production.
EDTECH_STORAGE_BACKEND=local
# EDTECH_STORAGE_BACKEND=s3
# EDTECH_S3_BUCKET=edtech-dev
# EDTECH_S3_ENDPOINT_URL=http://localhost:9000
# EDTECH_S3_REGION=us-east-1
# EDTECH_S3_ACCESS_KEY_ID=minioadmin
# EDTECH_S3_SECRET_ACCESS_KEY=minioadmin

EDTECH_SIGNUP_FREE_CREDITS=5
EDTECH_FEATURE_CORRECTIONS_ENABLED=false
